# ==============================================================================
# MEDDRAINN HEALTHCARE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit real credentials, database strings, or secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Obtain from your Neon Console (https://console.neon.tech)
# Use the pooled connection string (with ?sslmode=require) for optimal serverless performance.
DATABASE_URL="postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION AUTHENTICATION (Jose JWT & Argon2id Password Security)
# ------------------------------------------------------------------------------
# Secret key used for signing administrator session JWTs (minimum 32 random characters)
AUTH_SECRET="your-random-secret-key-at-least-32-characters-long"

# ------------------------------------------------------------------------------
# 3. DOMAIN & CANONICAL URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. OPTIONAL GOOGLE ANALYTICS 4
# ------------------------------------------------------------------------------
# Leave blank to disable analytics during development (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 5. NEON OBJECT STORAGE (S3-Compatible Object Store)
# ------------------------------------------------------------------------------
# Obtain from your Neon Console -> Object Storage
AWS_ACCESS_KEY_ID="your_object_storage_access_key_id"
AWS_SECRET_ACCESS_KEY="your_object_storage_secret_access_key"
AWS_ENDPOINT_URL_S3="https://storage.neon.tech"
AWS_REGION="us-east-1"
NEON_STORAGE_BUCKET="your_bucket_name"

# ------------------------------------------------------------------------------
# 6. INITIAL ADMINISTRATOR PROVISIONING (Used by `npm run create-admin`)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD="YourSecurePasswordHere"

# ------------------------------------------------------------------------------
# 7. NEON AUTH (Neon Data API & JWKS Integration - Optional)
# ------------------------------------------------------------------------------
NEON_AUTH_URL="https://ep-sample.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-sample.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
